# Proman additions to .env (Phase 3 Step 3 / ADR 0002).
#
# Source this alongside Plane's .env when running the overlay compose:
#   docker compose --env-file .env --env-file .env.proman \
#       -f docker-compose.yml -f docker-compose.proman.yml up
#
# Copy this file to .env.proman and fill in real values. Do NOT commit
# .env.proman — it's already in .gitignore via the standard `.env*` rule.

# ============================================================
# Cal.com bundled service
# ============================================================

# Postgres password — usually the same as Plane's POSTGRES_PASSWORD (shared instance).
# Set to whatever your Plane .env's POSTGRES_PASSWORD is.
CALCOM_DATABASE_PASSWORD=changeme

# NextAuth — Cal.com uses NextAuth.js for its own auth (Singleplayer mode).
# Generate: `openssl rand -base64 32`
CALCOM_NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32

# URLs — point Cal.com at where it'll be served. Reverse proxy maps these
# to the Cal.com container internally.
CALCOM_NEXTAUTH_URL=https://your-proman-domain.example.com/cal
CALCOM_PUBLIC_WEBAPP_URL=https://your-proman-domain.example.com/cal

# Encryption key for at-rest sensitive Cal.com data.
# Generate: `openssl rand -base64 32`
CALCOM_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32

# Webhook secret — Cal.com signs BOOKING_CREATED webhooks with this.
# MUST also be set as CALCOM_WEBHOOK_SECRET in the Plane backend env
# (the calcom_webhook view reads it for HMAC verification).
# Generate: `openssl rand -hex 32`
CALCOM_WEBHOOK_SECRET=replace-with-openssl-rand-hex-32

# From-address for Cal.com transactional emails.
CALCOM_EMAIL_FROM=hello@your-proman-domain.example.com

# ============================================================
# AWS SES SMTP (carries forward from Bookend ADR — same setup)
# Used by Cal.com for transactional email (booking confirmations, reminders).
# Plane uses its own email setup separately.
# ============================================================
AWS_SES_SMTP_HOST=email-smtp.us-east-1.amazonaws.com
AWS_SES_SMTP_USER=your-ses-smtp-username
AWS_SES_SMTP_PASSWORD=your-ses-smtp-password
